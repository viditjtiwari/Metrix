# ==============================================================================
# METRIX Environment Configuration Template
# Copy this file to `.env` (or `backend/.env`) and update values as needed.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Application
APP_NAME=METRIX
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=metrix-insecure-dev-secret-key-change-in-production-min32chars

# Database (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security / Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
